/-
Loewner evolution driven by complex Brownian motion: a formalization of arXiv:2203.07313v4
(Gwynne–Pfeffer).
-/
module

public import Mathlib.Probability.Independence.Basic
public import Mathlib.MeasureTheory.Constructions.BorelSpace.Complex
public import Mathlib.Topology.Order.Compact
public import Mathlib.Topology.Instances.NNReal.Lemmas

/-!
# Lemma 4.1: events depending on a path up to a fixed time

For a process `Y` with continuous paths, the event `{∀ t ≤ T, ‖Y t - g t‖ < η}` is measurable for
the σ-algebra `σ(Y r : r ≤ T)` generated by the path up to time `T`, although it is defined by an
uncountable family of conditions: by continuity and compactness it equals
`⋃ m, ⋂ q ∈ D, {‖Y q - g q‖ ≤ η - 1/(m+1)}` for a countable dense set `D ⊆ [0, T]`.
-/

public section

open scoped NNReal
open MeasureTheory Set

namespace ComplexSLE.Internal

variable {Ω : Type*}

/-- **Events up to time `T` are measurable for the past σ-algebra.** -/
theorem measurableSet_forall_norm_sub_lt (Y : ℝ≥0 → Ω → ℂ) (g : ℝ≥0 → ℂ) (hg : Continuous g)
    (hY : ∀ ω, Continuous fun t => Y t ω) (T : ℝ≥0) (η : ℝ) :
    MeasurableSet[MeasurableSpace.comap (fun ω (r : Set.Iic T) => Y r ω) MeasurableSpace.pi]
      {ω | ∀ t ≤ T, ‖Y t ω - g t‖ < η} := by
  obtain ⟨d, hd⟩ : ∃ d : ℕ → Set.Iic T, DenseRange d :=
    TopologicalSpace.exists_dense_seq (Set.Iic T)
  have hcmp : IsCompact (Set.Iic T) := by
    have := isCompact_Icc (a := (⊥ : ℝ≥0)) (b := T)
    rwa [Set.Icc_bot] at this
  have : CompactSpace (Set.Iic T) := isCompact_iff_compactSpace.1 hcmp
  set A : Set (Set.Iic T → ℂ) :=
    ⋃ m : ℕ, ⋂ n : ℕ, {f | ‖f (d n) - g (d n)‖ ≤ η - 1 / ((m : ℝ) + 1)} with hA
  have hAm : MeasurableSet A :=
    MeasurableSet.iUnion fun m => MeasurableSet.iInter fun n =>
      measurableSet_le (measurable_norm.comp ((measurable_pi_apply (d n)).sub_const _))
        measurable_const
  have hfun : ∀ ω, Continuous fun r : Set.Iic T => ‖Y r ω - g r‖ := fun ω =>
    (((hY ω).comp continuous_subtype_val).sub (hg.comp continuous_subtype_val)).norm
  have heq : {ω | ∀ t ≤ T, ‖Y t ω - g t‖ < η} = (fun ω (r : Set.Iic T) => Y r ω) ⁻¹' A := by
    ext ω
    simp only [mem_ofPred_eq, mem_preimage, hA, mem_iUnion, mem_iInter]
    constructor
    · intro h
      obtain ⟨r₀, -, hr₀⟩ := isCompact_univ.exists_isMaxOn (s := (univ : Set (Set.Iic T)))
        ⟨(⟨(0 : ℝ≥0), Set.mem_Iic.2 zero_le⟩ : Set.Iic T), mem_univ _⟩ (hfun ω).continuousOn
      rw [isMaxOn_univ_iff] at hr₀
      have hlt : ‖Y r₀ ω - g r₀‖ < η := h r₀ r₀.2
      obtain ⟨m, hm⟩ := exists_nat_one_div_lt (sub_pos.2 hlt)
      exact ⟨m, fun n => by have := hr₀ (d n); linarith⟩
    · rintro ⟨m, hm⟩ t ht
      have hall : ∀ r : Set.Iic T, ‖Y r ω - g r‖ ≤ η - 1 / ((m : ℝ) + 1) := by
        intro r
        refine hd.induction_on (p := fun r => ‖Y r ω - g r‖ ≤ η - 1 / ((m : ℝ) + 1)) r ?_ hm
        exact isClosed_le (hfun ω) continuous_const
      have := hall ⟨t, ht⟩
      have hpos : (0 : ℝ) < 1 / ((m : ℝ) + 1) := by positivity
      simp only at this
      linarith
  rw [heq]
  exact ⟨A, hAm, rfl⟩

end ComplexSLE.Internal

end
