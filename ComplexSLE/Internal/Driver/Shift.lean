/-
Loewner evolution driven by complex Brownian motion: a formalization of arXiv:2203.07313v4
(Gwynne–Pfeffer).
-/
module

public import ComplexSLE.Frozen.Defs.IsSLEDriver
import ComplexSLE.Internal.Driver.Chain
import ComplexSLE.Internal.Driver.Transform
import Mathlib.Probability.Independence.Process.Basic

/-!
# Markov property of the driver at a deterministic time

For an `SLE_Σ` driver `U` and a deterministic time `t ≥ 0`:

* `IsSLEDriver.shift`: `s ↦ U (s + t) - U t` is again an `SLE_Σ` driver (same `(a, b, c)`);
* `IsSLEDriver.indep_shift_past`: the σ-algebra generated by the shifted process is independent
  of the σ-algebra generated by `(U r)_{r ≤ t}` (paper.tex:L788, for deterministic `T = t`).

The independence is proved from `HasIndepIncrements`: a finite family of times of the past and a
finite family of times of the future are placed on one monotone chain
(`ComplexSLE.Internal.exists_chain`), the corresponding values are partial sums of independent
increments of the chain, and the sums over the initial and the final segment of the chain are
independent.
-/

public section

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace ComplexSLE.IsSLEDriver

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {a b c : ℝ} {U : ℝ≥0 → Ω → ℂ}

/-- Each coordinate `U t` of an `SLE_Σ` driver is a.e.-measurable. -/
theorem aemeasurable (hU : IsSLEDriver a b c U P) (t : ℝ≥0) : AEMeasurable (U t) P := by
  have h := (hU.law_increment 0 t zero_le).aemeasurable
  refine h.congr ?_
  filter_upwards [hU.zero] with ω hω
  simp [hω]

/-- **Shift at a deterministic time.** If `U` is an `SLE_Σ` driver and `t ≥ 0`, then
`s ↦ U (s + t) - U t` is an `SLE_Σ` driver with the same `(a, b, c)`. -/
theorem shift (hU : IsSLEDriver a b c U P) (t : ℝ≥0) :
    IsSLEDriver a b c (fun s ω => U (s + t) ω - U t ω) P := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · filter_upwards [hU.cont] with ω hω
    exact (hω.comp (continuous_id.add continuous_const)).sub continuous_const
  · exact Filter.Eventually.of_forall fun ω => by simp
  · intro n s hs
    have := hU.indepIncrements n (fun i => s i + t) (fun i j hij => by simpa using hs hij)
    convert this using 3 with i ω
    ring
  · intro s s' hss'
    have := hU.law_increment (s + t) (s' + t) (by gcongr)
    convert this using 2
    · ring
    · simp

private theorem sum_coe_ite_lt (s : Finset ℕ) (F : ℕ → ℂ) (n : ℕ) :
    ∑ j : s, (if (j : ℕ) < n then F j else 0) = ∑ j ∈ s.filter (· < n), F j := by
  rw [Finset.sum_coe_sort s (fun j => if j < n then F j else 0), Finset.sum_filter]

private theorem sum_Ico_sub' (f : ℕ → ℂ) {q i : ℕ} (h : q ≤ i) :
    ∑ j ∈ Finset.Ico q i, (f (j + 1) - f j) = f i - f q := by
  have h1 := Finset.sum_range_add_sum_Ico (fun j => f (j + 1) - f j) h
  rw [Finset.sum_range_sub, Finset.sum_range_sub] at h1
  linear_combination h1

/-- Finite-dimensional version of the independence of the future increments from the past. -/
theorem indepFun_shift_past_finite (hU : IsSLEDriver a b c U P) (t : ℝ≥0) (I : Finset ℝ≥0)
    (J : Finset (Set.Iic t)) :
    IndepFun (fun ω (s : I) => U ((s : ℝ≥0) + t) ω - U t ω) (fun ω (r : J) => U (r : ℝ≥0) ω) P := by
  classical
  -- one monotone chain through all the relevant times
  obtain ⟨p, M, hmono, hp0, hcov, hmem, hle⟩ :=
    Internal.exists_chain (insert t (I.image (· + t) ∪ J.image (fun r : Set.Iic t => r.1)))
  obtain ⟨q, hqM, hq⟩ := hcov t (Finset.mem_insert_self _ _)
  have hI : ∀ s : I, ∃ i, q ≤ i ∧ i ≤ M ∧ p i = (s : ℝ≥0) + t := by
    intro s
    obtain ⟨i, hiM, hi⟩ := hcov ((s : ℝ≥0) + t) (by
      refine Finset.mem_insert_of_mem (Finset.mem_union_left _ ?_)
      exact Finset.mem_image.2 ⟨s, s.2, rfl⟩)
    by_cases hqi : q ≤ i
    · exact ⟨i, hqi, hiM, hi⟩
    · refine ⟨q, le_rfl, hqM, ?_⟩
      have h1 : (s : ℝ≥0) + t ≤ t := by
        rw [← hi]
        calc p i ≤ p q := hmono (by omega)
          _ = t := hq
      have h2 : (t : ℝ≥0) ≤ (s : ℝ≥0) + t := by simp
      rw [hq]
      exact le_antisymm h2 h1
  have hJ : ∀ r : J, ∃ i, i ≤ q ∧ p i = (r : Set.Iic t) := by
    intro r
    obtain ⟨i, hiM, hi⟩ := hcov ((r : Set.Iic t) : ℝ≥0) (by
      refine Finset.mem_insert_of_mem (Finset.mem_union_right _ ?_)
      exact Finset.mem_image.2 ⟨r, r.2, rfl⟩)
    by_cases hiq : i ≤ q
    · exact ⟨i, hiq, hi⟩
    · refine ⟨q, le_rfl, ?_⟩
      have h1 : t ≤ ((r : Set.Iic t) : ℝ≥0) := by
        rw [← hi]
        calc t = p q := hq.symm
          _ ≤ p i := hmono (by omega)
      have h2 : ((r : Set.Iic t) : ℝ≥0) ≤ t := (r : Set.Iic t).2
      rw [hq]
      exact le_antisymm h1 h2
  choose iI hqi hiM hpi using hI
  choose iJ hiq hpj using hJ
  have := hU.isProbabilityMeasure
  set Δ : ℕ → Ω → ℂ := fun j ω => U (p (j + 1)) ω - U (p j) ω with hΔdef
  have hΔ : iIndepFun Δ P := hU.indepIncrements.nat hmono
  have mΔ : ∀ j, AEMeasurable (Δ j) P := fun j => (hU.aemeasurable _).sub (hU.aemeasurable _)
  have key := hΔ.indepFun_finset₀ (Finset.Ico q M) (Finset.range q) (by
    rw [Finset.disjoint_left]
    intro x hx hx'
    simp only [Finset.mem_Ico, Finset.mem_range] at hx hx'
    omega) mΔ
  let g₂ : (Finset.Ico q M → ℂ) → (I → ℂ) := fun y s =>
    ∑ j : Finset.Ico q M, if (j : ℕ) < iI s then y j else 0
  let g₁ : (Finset.range q → ℂ) → (J → ℂ) := fun y r =>
    ∑ j : Finset.range q, if (j : ℕ) < iJ r then y j else 0
  have hg₂ : Measurable g₂ := by
    refine measurable_pi_iff.2 fun s => Finset.measurable_sum _ fun j _ => ?_
    by_cases h : (j : ℕ) < iI s <;> simp only [h, ite_true, ite_false] <;> fun_prop
  have hg₁ : Measurable g₁ := by
    refine measurable_pi_iff.2 fun r => Finset.measurable_sum _ fun j _ => ?_
    by_cases h : (j : ℕ) < iJ r <;> simp only [h, ite_true, ite_false] <;> fun_prop
  refine (key.comp hg₂ hg₁).congr ?_ ?_
  · filter_upwards with ω
    funext s
    have e1 : (Finset.Ico q M).filter (· < iI s) = Finset.Ico q (iI s) := by
      ext j
      simp only [Finset.mem_filter, Finset.mem_Ico]
      have := hqi s
      have := hiM s
      omega
    have e2 := sum_Ico_sub' (fun j => U (p j) ω) (hqi s)
    simp only [g₂, Function.comp_apply]
    rw [sum_coe_ite_lt (Finset.Ico q M) (fun j => Δ j ω) (iI s), e1]
    simp only [Δ]
    rw [e2, hpi s, hq]
  · filter_upwards [hU.zero] with ω h0
    funext r
    have e1 : (Finset.range q).filter (· < iJ r) = Finset.range (iJ r) := by
      ext j
      simp only [Finset.mem_filter, Finset.mem_range]
      have := hiq r
      omega
    have e2 := Finset.sum_range_sub (fun j => U (p j) ω) (iJ r)
    simp only [g₁, Function.comp_apply]
    rw [sum_coe_ite_lt (Finset.range q) (fun j => Δ j ω) (iJ r), e1]
    simp only [Δ]
    rw [e2, hpj r, hp0, h0, sub_zero]

/-- **Markov property at a deterministic time, independence part.** For an `SLE_Σ` driver `U` and
`t ≥ 0`, the shifted process `(U (s + t) - U t)_{s ≥ 0}` is independent of `(U r)_{r ≤ t}`. -/
theorem indepFun_shift_past (hU : IsSLEDriver a b c U P) (t : ℝ≥0) :
    IndepFun (fun ω (s : ℝ≥0) => U (s + t) ω - U t ω) (fun ω (r : Set.Iic t) => U (r : ℝ≥0) ω)
      P := by
  have := hU.isProbabilityMeasure
  exact IndepFun.process_indepFun_process₀
    (X := fun (s : ℝ≥0) ω => U (s + t) ω - U t ω) (Y := fun (r : Set.Iic t) ω => U (r : ℝ≥0) ω)
    (fun s => (hU.aemeasurable _).sub (hU.aemeasurable _)) (fun r => hU.aemeasurable _)
    (fun I J => hU.indepFun_shift_past_finite t I J)

/-- **Markov property at a deterministic time, σ-algebra form.** The σ-algebra generated by the
shifted process `(U (s + t) - U t)_{s ≥ 0}` is independent of the σ-algebra generated by
`(U r)_{r ≤ t}`. -/
theorem indep_shift_past (hU : IsSLEDriver a b c U P) (t : ℝ≥0) :
    Indep
      (MeasurableSpace.comap (fun ω (s : ℝ≥0) => U (s + t) ω - U t ω) MeasurableSpace.pi)
      (MeasurableSpace.comap (fun ω (r : Set.Iic t) => U (r : ℝ≥0) ω) MeasurableSpace.pi) P :=
  hU.indepFun_shift_past t

end ComplexSLE.IsSLEDriver

end
